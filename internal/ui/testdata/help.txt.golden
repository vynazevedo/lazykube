                                                                                            
                                                                                                                                                                
                                                                                                                                                                
                                                                                                                                                                
                                                                                                                                                                
                                   ╭─ Help ────────────────────────────────────────────────────────────────────────────────╮                                    
                                   │                                                                                       │                                    
                                   │  ↑/↓ k/j    move selection                 home/end   top / bottom                    │                                    
                                   │  tab        next panel                     f          toggle follow (Log)             │                                    
                                   │  shift+tab  previous panel                 s          shell in pod                    │                                    
                                   │  /          filter pods                    ctrl+d     delete pod                      │                                    
                                   │  enter      confirm / filter namespace     ctrl+k     switch context                  │                                    
                                   │  esc        leave filter / clear           p          cycle palette                   │                                    
                                   │  l c t d e  Log Config Top Describe Events 1          toggle left column              │                                    
                                   │  S          Security / namespace posture   ctrl+p     pause animations                │                                    
                                   │  [ ]        previous / next tab            ?          toggle help                     │                                    
                                   │  pgup/pgdn  scroll viewport                q ctrl+c   quit                            │                                    
                                   │                                                                                       │                                    
                                   ╰───────────────────────────────────────────────────────────────────────────────────────╯                                    
                                                                                                                                                                
                                                                                                                                                                
                                                                                                                                                                
                                                                                                                                                                
                                                                                                                                                                
                                                                                                                                                                
                                                                                                                                                                
                                                                                                                                                                
                                                                                                                                                                
                                                                                                                                                                
                                                                                                                                                                
                                                                                                                                                                
                                                                                                                                                                
                                                                                                                                                                
                                                                                                                                                                
                                                                                                                                                                
                                                                                                                                                                